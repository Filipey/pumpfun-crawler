# ── Solana RPC endpoints ──────────────────────────────────────────────────────
# Comma-separated list. Free tiers work; add multiple for rotation + speed.
# Helius (recommended free tier): https://dev.helius.xyz
# QuickNode free: https://www.quicknode.com
# Public fallback (slow, rate-limited):
RPC_ENDPOINTS=https://api.mainnet-beta.solana.com

# Example with multiple endpoints (copy and uncomment):
# RPC_ENDPOINTS=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY,https://api.mainnet-beta.solana.com

# ── Collection window ─────────────────────────────────────────────────────────
# COLLECT_START=2026-01-01
# COLLECT_END=2026-05-12

# ── Concurrency ───────────────────────────────────────────────────────────────
# Number of parallel decode workers (default: 4)
# WORKERS=4

# ── Storage ───────────────────────────────────────────────────────────────────
# Where to write the data/ directory (default: ./data in repo root)
# DATA_DIR=./data
