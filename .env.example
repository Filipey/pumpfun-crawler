# ── Collection window ─────────────────────────────────────────────────────────
# Defaults are set in config.py; override here if needed
# COLLECT_START=2026-01-01
# COLLECT_END=2026-05-12

# ── Concurrency ───────────────────────────────────────────────────────────────
# Number of parallel worker threads (default: 4)
# WORKERS=4

# ── Storage ───────────────────────────────────────────────────────────────────
# Where to write data/ directory (default: ./data in repo root)
# DATA_DIR=./data
