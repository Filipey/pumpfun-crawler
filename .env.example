# ── Phase A: SolArchive backfill (primary, free, no API key needed) ──────────
# SOLARCHIVE_START=2025-11-01
# SOLARCHIVE_END=2025-12-05

# Concurrent shard fetches. Each concurrent shard holds tens of thousands of
# decoded events in memory until the next flush — raise cautiously and watch
# `free -h` on the first run at a new value. See README "Memory notes".
# SOLARCHIVE_WORKERS=4

# ── Phase B: Old Faithful / Jetstreamer backfill ──────────────────────────────
# Requires building pumpfun_filter_plugin/ first (Rust + Clang16 + RocksDB
# deps) — see that crate's README.
# OLDFAITHFUL_START=2025-12-06
# OLDFAITHFUL_END=2026-07-04
# JETSTREAMER_BIN=./pumpfun_filter_plugin/target/release/pumpfun-filter-plugin

# ── Storage ───────────────────────────────────────────────────────────────────
# Where to write the data/ directory (default: ./data in repo root)
# DATA_DIR=./data

# Image blob shards live here. Kept separate from DATA_DIR on purpose: at
# ~9.3M tokens this is ~140GB while everything else is a few GB, so it often
# belongs on a different disk. Default: $DATA_DIR/images
# IMAGES_DIR=./data/images

# ── Phase C: off-chain metadata + images (collect_metadata.py) ───────────────
# tokens.uri mostly points at ipfs.io, which now 429s everything. The CID is
# extracted and walked through this pool, in order, until one serves it.
# METADATA_GATEWAYS=https://pump.mypinata.cloud/ipfs/,https://ipfs.filebase.io/ipfs/,https://ipfs.raribleuserdata.com/ipfs/,https://gateway.pinata.cloud/ipfs/

# "original" (default) downloads the source image and resizes locally: faster
# (one round trip, not two), smaller on disk, and it keeps the original
# dimensions. "transform" has the gateway resize server-side — ~10x less
# download for ~1.5x the wall clock. Use it on a metered connection.
# IMAGE_STRATEGY=original

# 384px keeps SigLIP-384 / Qwen2-VL usable; 224 halves disk but locks you out
# of the 336/384 encoders. Changing this means re-collecting.
# IMG_TARGET_PX=384
# IMG_WEBP_QUALITY=85

# Above this, the original is not downloaded in full — only its header, for
# dimensions — and a bounded rendition is fetched instead.
# IMG_MAX_ORIG_BYTES=4194304

# Rows per blob shard (~10k x ~16KB ≈ 160MB/shard).
# IMG_SHARD_ROWS=10000

# Concurrency per stage.
# METADATA_WORKERS=32
# IMAGE_WORKERS=32
# API_WORKERS=32

# Politeness: we pull ~2.5TB through gateways we don't pay for. Per-host caps.
# GATEWAY_RATE_LIMIT=30
# PUMP_API_RATE_LIMIT=50

# Identify the crawl. Put a real contact address here before a multi-day run.
# CRAWLER_UA=pumpfun-research-crawler/0.1 (UFMG LOCUS; academic research; you@example.com)

# ── Legacy: raw-RPC crawler (collect_rpc.py) ──────────────────────────────────
# Only needed if you fall back to the RPC-based path. Comma-separated list;
# multiple endpoints are rotated round-robin.
# Helius (free tier): https://dev.helius.xyz
# QuickNode free: https://www.quicknode.com
RPC_ENDPOINTS=https://api.mainnet-beta.solana.com
# RPC_ENDPOINTS=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY,https://api.mainnet-beta.solana.com

# COLLECT_START=2026-01-01
# COLLECT_END=2026-05-12
# WORKERS=4
