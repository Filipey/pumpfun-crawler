# ── Dune Analytics ───────────────────────────────────────────────────────────
# Get your key at: https://dune.com/settings/api
DUNE_API_KEY=your_dune_api_key_here

# Saved query IDs — create these once in the Dune IDE, then paste the IDs.
# Run: python collect_dune_auto.py --setup  for step-by-step instructions.
# The query ID is the number in the URL: dune.com/queries/XXXXXXX
DUNE_QUERY_CREATIONS=0
DUNE_QUERY_TRADES=0
DUNE_QUERY_MIGRATIONS=0

# ── Bitquery (continuous real-time collection) ────────────────────────────────
# Get your key at: https://account.bitquery.io
BITQUERY_TOKEN=your_bitquery_token_here

# ── Storage ───────────────────────────────────────────────────────────────────
# Defaults to ./data — change if you want data on a different disk
DATA_DIR=./data
